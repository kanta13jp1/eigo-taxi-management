{
  "name": "eigo-taxi-management",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firebase": "tsc -b && vite build --base=/ && node scripts/prepare_test_release.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:mighty-test": "npm run build:firebase && firebase deploy --only hosting:mighty-test --project eigo-taxi-app --account k-umezawa@ml-mightylink.com --non-interactive",
    "lint": "oxlint",
    "preview": "vite preview",
    "docs:generate": "node scripts/traceability_cli.cjs generate",
    "docs:index": "node scripts/traceability_cli.cjs index",
    "docs:check": "node scripts/traceability_cli.cjs check",
    "docs:check:strict": "node scripts/traceability_cli.cjs check --strict-coverage",
    "test:traceability": "node scripts/traceability_cli.cjs test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "13.0.0",
    "lucide-react": "^1.52.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "jsqr": "1.4.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
